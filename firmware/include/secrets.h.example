#pragma once

// Copy this file to secrets.h and fill in your WiFi credentials
#define WIFI_SSID      "your-wifi-ssid"
#define WIFI_PASSWORD  "your-wifi-password"

// Fallback WiFi (tried if primary fails)
#define WIFI_SSID2     ""
#define WIFI_PASSWORD2 ""

// inkless-server (AI modes + printing), see README. The page tries the hostname first,
// then the IP fallback for browsers that cannot resolve .local names. Leave both "" to disable.
#define INKLESS_SERVER_URL          "http://inkless-host.local:8100"
#define INKLESS_SERVER_URL_FALLBACK "http://192.168.1.10:8100"
